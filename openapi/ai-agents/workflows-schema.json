{
  "openapi": "3.0.3",
  "info": {
    "title": "Workflow API",
    "version": "1.0",
    "description": "⚠️ Beta Notice: This is a minimal working example."
  },
  "servers": [
    { "url": "https://api.example.com" }
  ],
  "paths": {
    "/v1/workflows/schema": {
      "get": {
        "summary": "Get available workflows",
        "operationId": "getWorkflows",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string", "example": "Example text" },
                    "agent_names": {
                      "type": "array",
                      "items": { "type": "string" },
                      "example": ["agent1", "agent2"]
                    }
                  },
                  "required": ["text", "agent_names"]
                }
              }
            }
          }
        }
      }
    }
  }
}
