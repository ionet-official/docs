{
  "openapi": "3.1.0",
  "info": {
    "title": "Workflow API",
    "version": "1.0",
    "description": "⚠️ **Beta Notice**: This project is in rapid development and may not be stable for production use."
  },
  "servers": [
    {
      "url": "https://api.example.com"
    }
  ],
  "paths": {
    "/v1/workflows/schema": {
      "get": {
        "tags": ["agents"],
        "summary": "Get Default Workflows",
        "operationId": "get_default_workflows_v1_workflows_schema_get",
        "parameters": [
          {
            "name": "token",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "JWT token"
          },
          {
            "name": "Authorization",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "io.net provided API Key"
          },
          {
            "name": "x-api-key",
            "in": "header",
            "required": false,
            "schema": { "type": "string" },
            "description": "API key set by an SDK client"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "404": { "description": "Not found" },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HTTPValidationError" }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "HTTPValidationError": {
        "type": "object",
        "properties": {
          "detail": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ValidationError" }
          }
        }
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "loc": { "type": "array", "items": { "type": "string" } },
          "msg": { "type": "string" },
          "type": { "type": "string" }
        },
        "required": ["loc", "msg", "type"]
      },
      "ClassificationArgs": {
        "type": "object",
        "required": ["classify_by"],
        "properties": {
          "classify_by": {
            "type": "array",
            "items": { "type": "string" },
            "title": "Classify By"
          }
        }
      },
      "CustomArgs": {
        "type": "object",
        "required": ["name","objective","instructions"],
        "properties": {
          "name": { "type": "string", "description": "Unique name/ID for the custom workflow step." },
          "objective": { "type": "string", "description": "Primary objective or text prompt for the workflow." },
          "instructions": { "type": "string", "description": "Optional instructions to be passed along." },
          "context": { "type": "object", "description": "Additional context or parameters." }
        }
      },
      "ExtractEntitiesArgs": { "type": "object", "properties": {} },
      "ModerationArgs": {
        "type": "object",
        "required": ["threshold"],
        "properties": { "threshold": { "type": "number", "title": "Threshold" } }
      },
      "PersonaConfig": {
        "type": "object",
        "description": "A configuration object that describes an agent's persona or character.",
        "properties": {
          "name": { "type": "string", "nullable": true, "description": "If the persona has a specific name or nickname." },
          "age": { "type": "integer", "minimum": 1, "nullable": true, "description": "Approximate age of the persona (if relevant)." },
          "role": { "type": "string", "nullable": true, "description": "General role or type, e.g. 'a brave knight', 'a friendly teacher', etc." },
          "style": { "type": "string", "nullable": true, "description": "A short description of the agent's style or demeanor." },
          "domain_knowledge": { "type": "array", "items": { "type": "string" }, "description": "List of domains or special areas of expertise the agent has." }
        }
      },
      "ReasoningArgs": { "type": "object", "properties": {} },
      "SentimentArgs": { "type": "object", "properties": {} },
      "SummarizeArgs": { "type": "object", "properties": { "max_words": { "type": "integer", "default": 100 } } },
      "TranslateArgs": { "type": "object", "required": ["target_language"], "properties": { "target_language": { "type": "string" } } }
    }
  }
}
