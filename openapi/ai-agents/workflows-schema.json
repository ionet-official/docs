{
  "openapi": "3.1.0",
  "info": {
    "title": "Workflow API",
    "version": "1.0"
  },
  "servers": [
    { "url": "https://api.example.com" }
  ],
  "paths": {
    "/v1/workflows/schema": {
      "get": {
        "tags": ["agents"],
        "summary": "Get Default Workflows",
        "operationId": "get_default_workflows",
        "parameters": [
          { "name": "token", "in": "header", "schema": { "type": "string" } },
          { "name": "Authorization", "in": "header", "schema": { "type": "string" } },
          { "name": "x-api-key", "in": "header", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": { "type": "string", "example": "ok" }
                  }
                }
              }
            }
          },
          "404": { "description": "Not found" },
          "422": { "description": "Validation error" }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ClassificationArgs": {
        "type": "object",
        "properties": {
          "classify_by": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["classify_by"]
      },
      "CustomArgs": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "objective": { "type": "string" },
          "instructions": { "type": "string" }
        },
        "required": ["name","objective","instructions"]
      },
      "PersonaConfig": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "nullable": true },
          "age": { "type": "integer", "nullable": true }
        }
      }
    }
  }
}
