{
  "openapi": "3.0.3",
  "info": {
    "title": "Workflow API Skeleton",
    "version": "1.0",
    "description": "⚠️ Beta Notice: Minimal working skeleton for Mintlify. All complex fields removed."
  },
  "servers": [
    { "url": "https://api.example.com" }
  ],
  "paths": {
    "/v1/workflows/schema": {
      "get": {
        "summary": "Get workflow schema (minimal skeleton)",
        "operationId": "getWorkflowsSkeleton",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": {
                      "type": "string",
                      "example": "Example workflow text"
                    },
                    "agent_name": {
                      "type": "string",
                      "example": "agent1"
                    }
                  },
                  "required": ["text", "agent_name"]
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "text/plain": { "example": "Not found" }
            }
          },
          "422": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "example": {
                  "detail": [
                    { "loc": ["body","text"], "msg": "field required", "type": "value_error.missing" }
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
