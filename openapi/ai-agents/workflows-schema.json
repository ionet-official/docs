{
  "openapi": "3.0.3",
  "info": {
    "title": "Workflow API Minimal",
    "version": "1.0",
    "description": "⚠️ Beta Notice: This is the simplest working example for Mintlify."
  },
  "servers": [
    { "url": "https://api.example.com" }
  ],
  "paths": {
    "/v1/workflows/schema": {
      "get": {
        "summary": "Get available workflows",
        "operationId": "getWorkflowsMinimal",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "text": { "type": "string", "example": "Example text" },
                    "agent_name": { "type": "string", "example": "agent1" }
                  },
                  "required": ["text", "agent_name"]
                }
              }
            }
          }
        }
      }
    }
  }
}
