{
  "openapi": "3.0.0",
  "info": {
    "title": "IO.NET VMaaS API",
    "version": "1.0.0"
  },
  "paths": {
    "/enterprise/v1/io-cloud/vmaas/deployment/{deployment_id}/extend": {
      "post": {
        "summary": "Extend Cluster",
        "description": "Extend the lifetime or capacity of an existing deployment by adding more resources or increasing its duration.",
        "operationId": "extendCluster",
        "parameters": [
          {
            "name": "deployment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Unique ID of the deployment to extend"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "duration_hours": {
                    "type": "integer",
                    "example": 1,
                    "description": "Number of hours to extend the deployment"
                  }
                },
                "required": ["duration_hours"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful response with updated deployment details",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": { "type": "string", "example": "3fa85f64-5717-4562-b3fc-2c963f66afa6" },
                        "status": { "type": "string", "example": "active" },
                        "created_at": { "type": "string", "format": "date-time" },
                        "started_at": { "type": "string", "format": "date-time" },
                        "finished_at": { "type": "string", "format": "date-time" },
                        "amount_paid": { "type": "integer", "example": 0 },
                        "completed_percent": { "type": "integer", "example": 0 },
                        "total_gpus": { "type": "integer", "example": 0 },
                        "gpus_per_vm": { "type": "integer", "example": 0 },
                        "total_vms": { "type": "integer", "example": 0 },
                        "hardware_name": { "type": "string", "example": "NVIDIA A100" },
                        "hardware_id": { "type": "integer", "example": 101 },
                        "locations": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": { "type": "integer", "example": 0 },
                              "iso2": { "type": "string", "example": "US" },
                              "name": { "type": "string", "example": "US-East" }
                            }
                          }
                        },
                        "brand_name": { "type": "string", "example": "NVIDIA" },
                        "compute_minutes_served": { "type": "integer", "example": 0 },
                        "compute_minutes_remaining": { "type": "integer", "example": 0 },
                        "ssh_keys": {
                          "type": "object",
                          "additionalProperties": { "type": "string" }
                        },
                        "github_ids": {
                          "type": "array",
                          "items": { "type": "string", "example": "github_user_1" }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Deployment not found"
          },
          "422": {
            "description": "Validation error"
          }
        },
        "security": [
          {
            "api_key": []
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    }
  }
}
