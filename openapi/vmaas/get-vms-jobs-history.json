{
  "openapi": "3.1.0",
  "info": {
    "title": "IO API",
    "version": "1.0"
  },
  "paths": {
    "/enterprise/v1/io-cloud/vmaas/deployment/{deployment_id}/vms-jobs/{container_id}": {
      "get": {
        "summary": "Get VMs Jobs History",
        "description": "Retrieve the job execution history for a specific VM/container within a deployment. Includes logs and status of completed or active jobs.",
        "operationId": "getVMsJobsHistory",
        "parameters": [
          {
            "name": "deployment_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Deployment identifier"
          },
          {
            "name": "container_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Container identifier within the deployment"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 },
            "description": "Page number for paginated results"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 20, "maximum": 100 },
            "description": "Number of results per page (max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of VM job history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "total": { "type": "integer", "default": 0 },
                        "workers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "device_id": { "type": "string" },
                              "vm_id": { "type": "string" },
                              "hardware": { "type": "string" },
                              "brand_name": { "type": "string" },
                              "created_at": { "type": "string", "format": "date-time" },
                              "uptime_percent": { "type": "integer", "default": 0 },
                              "gpus_per_vm": { "type": "integer", "default": 0 },
                              "status": { "type": "string" },
                              "vm_events": {
                                "type": "array",
                                "items": {
                                  "type": "object",
                                  "properties": {
                                    "time": { "type": "string", "format": "date-time" },
                                    "message": { "type": "string" }
                                  }
                                }
                              },
                              "network_services": {
                                "type": "object",
                                "additionalProperties": {
                                  "type": "object",
                                  "properties": {
                                    "port": { "type": "integer" },
                                    "protocol": { "type": "string" },
                                    "whitelist": { "type": "array", "items": { "type": "string" } },
                                    "public_port": { "type": "integer" },
                                    "public_ip": { "type": "string" },
                                    "srv_record": { "type": "string" }
                                  }
                                }
                              },
                              "ssh_access": { "type": "string" }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": { "description": "Deployment or container not found" },
          "422": { "description": "Validation error" }
        },
        "security": [
          { "api_key": [] }
        ],
        "x-code-samples": [
          {
            "lang": "cURL",
            "source": "curl -X GET \"https://api.io.solutions/enterprise/v1/io-cloud/vmaas/deployment/{deployment_id}/vms-jobs/{container_id}?page=0&page_size=20\" \\\n  -H \"x-api-key: $IOCLOUD_API_KEY\" \\\n  -H \"Content-Type: application/json\""
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "api_key": {
        "type": "apiKey",
        "name": "x-api-key",
        "in": "header"
      }
    }
  }
}
