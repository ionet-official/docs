  "paths": {
    "/enterprise/v1/io-cloud/vmaas/deployment/{deployment_id}/vms-jobs/{container_id}": {
      "get": {
        "summary": "Get VMs Jobs History",
        "description": "Retrieve the job execution history for a specific VM/container within a deployment. Includes logs and status of completed or active jobs.",
        "operationId": "getVMsJobsHistory",
        "parameters": [
          {
            "name": "deployment_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Deployment identifier"
          },
          {
            "name": "container_id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" },
            "description": "Container identifier within the deployment"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 0 },
            "description": "Page number for paginated results"
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": { "type": "integer", "format": "int32", "default": 20, "maximum": 100 },
            "description": "Number of results per page (max: 100)"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful retrieval of VM job history",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "404": { "description": "Deployment or container not found" },
          "422": { "description": "Validation error" }
        },
        "security": [{ "api_key": [] }],
        "x-readme": {
          "code-samples": [
            {
              "language": "curl",
              "code": "curl -X GET \"https://api.io.solutions/enterprise/v1/io-cloud/vmaas/deployment/{deployment_id}/vms-jobs/{container_id}?page=0&page_size=20\" \\\n  -H \"x-api-key: $IOCLOUD_API_KEY\" \\\n  -H \"Content-Type: application/json\""
            },
            {
              "language": "python",
              "code": "import requests\n\nurl = \"https://api.io.solutions/enterprise/v1/io-cloud/vmaas/deployment/{deployment_id}/vms-jobs/{container_id}?page=0&page_size=20\"\nheaders = {\"x-api-key\": \"$IOCLOUD_API_KEY\", \"Content-Type\": \"application/json\"}\nresponse = requests.get(url, headers=headers)\nprint(response.status_code)\nprint(response.json())"
            }
          ],
          "samples-languages": ["curl", "python"]
        }
      }
    }
  },
