                "examples": {
                  "Result": {
                    "value": {
                      "data": {
                        "deployments": [
                          {
                            "id": "dep_123456",
                            "name": "My Deployment",
                            "status": "running",
                            "created_at": "2025-09-15T10:00:00Z",
                            "region": "us-east-1",
                            "configuration": {
                              "cpu": 4,
                              "memory": "16GB",
                              "gpu": 1
                            }
                          }
                        ],
                        "total": 1,
                        "page": 1,
                        "pageSize": 10
                      }
                    }
                  }
                },
