                                "example": "us-east-1"
                              },
                              "configuration": {
                                "type": "object",
                                "properties": {
                                  "cpu": {
                                    "type": "integer",
                                    "example": 4
                                  },
                                  "memory": {
                                    "type": "string",
                                    "example": "16GB"
                                  },
                                  "gpu": {
                                    "type": "integer",
                                    "example": 1
                                  }
                                }
                              }
                            }
                          }
                        },
                        "total": {
